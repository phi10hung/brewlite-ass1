# Database (docker-compose dùng các biến này)
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite
DATABASE_URL=postgresql://brewlite:brewlite@localhost:5432/brewlite?schema=public

# Backend (NestJS)
API_PORT=4000
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Thanh toán VNPay Sandbox: xin khoá ở Hùng, điền vào backend/.env (KHÔNG commit giá trị thật)
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNP_RETURN_URL=http://localhost:3000/payment/result
ORDER_PAYMENT_MINUTES=5

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
