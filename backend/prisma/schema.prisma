// BrewLite - DB Schema (Task 1)
// Đã tính trước cho Task 10: Product.version (optimistic locking),
// Payment.idempotencyKey (@unique), User.loyaltyPoints, Promotion, LoyaltyTransaction.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
}

enum Size {
  S
  M
  L
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PaymentStatus {
  SUCCESS
  FAILED
}

enum DiscountType {
  PERCENT
  FIXED
}

model User {
  id            Int                  @id @default(autoincrement())
  email         String               @unique
  password      String // mật khẩu đã băm bằng bcrypt
  name          String
  role          Role                 @default(CUSTOMER)
  loyaltyPoints Int                  @default(0)
  createdAt     DateTime             @default(now())
  orders        Order[]
  loyalty       LoyaltyTransaction[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String
  category    String
  price       Int // giá size S, đơn vị VND
  imageUrl    String
  stock       Int         @default(0) // số lượng còn bán được
  version     Int         @default(0) // tăng mỗi lần trừ tồn kho (optimistic locking)
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
}

model Topping {
  id    Int    @id @default(autoincrement())
  name  String
  price Int
}

model Order {
  id            Int                 @id @default(autoincrement())
  code          String              @unique // mã đơn hiển thị cho khách, ví dụ BL-7K2M9Q
  status        OrderStatus         @default(PENDING)
  subtotal      Int
  discount      Int                 @default(0)
  total         Int
  promotionCode String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id])
  userId        Int
  items         OrderItem[]
  payments      Payment[]
  loyalty       LoyaltyTransaction?
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     Int
  product     Product  @relation(fields: [productId], references: [id])
  productId   Int
  productName String // lưu lại tên lúc đặt, phòng khi sản phẩm đổi tên
  size        Size
  toppings    String[] // tên topping đã chọn
  quantity    Int
  unitPrice   Int
  lineTotal   Int
}

model Payment {
  id             Int           @id @default(autoincrement())
  order          Order         @relation(fields: [orderId], references: [id])
  orderId        Int
  method         PaymentMethod
  status         PaymentStatus
  amount         Int
  idempotencyKey String        @unique // cùng key = cùng một lần thanh toán
  createdAt      DateTime      @default(now())
}

model Promotion {
  id        Int          @id @default(autoincrement())
  code      String       @unique
  type      DiscountType
  value     Int // PERCENT: số %, FIXED: số tiền VND
  minOrder  Int          @default(0)
  active    Boolean      @default(true)
  expiresAt DateTime?
}

model LoyaltyTransaction {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   Int      @unique // mỗi đơn chỉ được cộng điểm 1 lần
  points    Int
  createdAt DateTime @default(now())
}
